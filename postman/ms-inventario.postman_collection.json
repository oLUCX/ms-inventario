          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"pm.response.json().nombre === \\\"Polera talla M azul\\\"\", () => pm.expect(pm.response.json().nombre === \"Polera talla M azul\").to.be.true);"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/productos/{{sku}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Polera talla M azul\",\n  \"stockDisponible\": 25\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
