          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"pm.response.json().stockDisponible === 20\", () => pm.expect(pm.response.json().stockDisponible === 20).to.be.true);",
              "pm.test(\"pm.response.json().stockReservado === 5\", () => pm.expect(pm.response.json().stockReservado === 5).to.be.true);"
            ]
          }
        }
      ],
