      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Responde 400\", () => pm.response.to.have.status(400));",
              "pm.test(\"pm.response.json().detalles.nombre !== undefined\", () => pm.expect(pm.response.json().detalles.nombre !== undefined).to.be.true);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
