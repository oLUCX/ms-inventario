{
  "info": {
    "_postman_id": "7fd00d6a-7609-d08c-422c-a01b3e03c90d",
    "name": "BodegaNube - ms-inventario",
    "description": "Catalogo y stock. Ejecutar en orden (Run collection): crea un producto, prueba errores, reserva, descuenta y lo elimina. Se puede repetir: el SKU cambia en cada ejecucion.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Crear producto (201)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"sku\", \"POLERA-M-\" + (Date.now() % 100000));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Responde 201\", () => pm.response.to.have.status(201));",
              "pm.test(\"pm.response.json().stockReservado === 0\", () => pm.expect(pm.response.json().stockReservado === 0).to.be.true);",
              "pm.test(\"pm.response.headers.has(\\\"Location\\\")\", () => pm.expect(pm.response.headers.has(\"Location\")).to.be.true);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/productos",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sku\": \"{{sku}}\",\n  \"nombre\": \"Polera talla M\",\n  \"stockDisponible\": 20\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Crear producto con SKU repetido (409)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Responde 409\", () => pm.response.to.have.status(409));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/productos",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sku\": \"{{sku}}\",\n  \"nombre\": \"Polera talla M\",\n  \"stockDisponible\": 20\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
